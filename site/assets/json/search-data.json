{{/* FlexSearch index data. Override of Hextra v0.12.3 assets/json/search-data.json.

  Two changes from upstream:
  - Pages are indexed under their full .Title, not .LinkTitle. The sidebar
    uses short linkTitle labels; the full title keeps the task words that
    search needs (site/scripts/browser_smoke.cjs ranks real task queries).
  - The theme's own glossary entry is added only when a termbase exists.
    Upstream always adds an empty "/<lang>/glossary" route titled "Glossary"
    in every language; this site has no such page.
*/}}
{{- $indexType := site.Params.search.flexsearch.index | default "content" -}}

{{- if not (in (slice "content" "summary" "heading" "title" ) $indexType) -}}
  {{- errorf "unknown flexsearch index type: %s" $indexType -}}
{{- end -}}

{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.excludeSearch" "!=" true -}}
{{- $pages = where $pages "Content" "!=" "" -}}

{{- $output := dict -}}

{{- range $index, $page := $pages -}}
  {{- $pageTitle := $page.Title | default $page.File.BaseFileName -}}
  {{- $pageLink := $page.RelPermalink -}}
  {{- $data := partial "utils/fragments" (dict "context" $page "type" $indexType) -}}
  {{- $output = $output | merge (dict $pageLink (dict "title" $pageTitle "data" $data)) -}}
{{- end -}}

{{- $siteData := partial "utils/hugo-compat/site-data.html" . -}}
{{- with (index $siteData .Site.Language.Lang "termbase") -}}
  {{- $glossaryEntries := dict -}}
  {{- range . -}}
    {{- $entry := cond (.abbr) (printf "%s %s %s" .abbr .term .definition) (printf "%s %s" .term .definition) -}}
    {{- $glossaryEntries = $glossaryEntries | merge (dict .term $entry) -}}
  {{- end -}}
  {{- $output = $output | merge (dict (relLangURL "glossary") (dict "title" "Glossary" "data" $glossaryEntries)) -}}
{{- end -}}

{{- $output | jsonify -}}
