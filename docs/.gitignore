# Jekyll build output and local caches — never part of the published site,
# regenerated by `bundle exec jekyll build`/`jekyll serve`.
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# The repo doesn't pin Gemfile.lock (CI runs bundler-cache: true against the
# Gemfile only); don't let a local `bundle install` add one out of band.
Gemfile.lock
