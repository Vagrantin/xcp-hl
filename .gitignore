# Jekyll build output and local caches under docs/ — never part of the
# published site, regenerated by `bundle exec jekyll build`/`jekyll serve`.
docs/_site/
docs/.sass-cache/
docs/.jekyll-cache/
docs/.jekyll-metadata

# docs/ doesn't pin Gemfile.lock (CI runs bundler-cache: true against the
# Gemfile only); don't let a local `bundle install` add one out of band.
docs/Gemfile.lock
