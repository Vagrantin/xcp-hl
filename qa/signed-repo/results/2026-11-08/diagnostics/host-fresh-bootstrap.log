# XCP-ng HomeLab Edition (XCP-HL) package repositories, bootstrap copy.
#
# Published at https://rpm.xcp-hl.org/xcp-hl.repo for hosts that do not yet have
# the xcp-hl-release package. Same settings as the packaged copy
# (xcp-hl/SOURCES/xcp-hl.repo), except gpgkey points at the published key over
# HTTPS, because a host bootstrapping from scratch has no local key yet.
#
# To bootstrap a running host:
#
#     curl -o /etc/yum.repos.d/xcp-hl.repo https://rpm.xcp-hl.org/xcp-hl.repo
#     rpm --import https://rpm.xcp-hl.org/xcp-ng-ce-public.asc
#     yum clean all && yum install xcp-hl-release
#
# The section names are a contract with xoa-hl and XCP-ng's updater.py: renaming
# one silently hides its packages from the Patches tab. See the packaged copy for
# why gpgcheck=0 sits next to repo_gpgcheck=1.

[xcp-hl-base]
name=XCP-HL - Base (repository configuration)
baseurl=https://rpm.xcp-hl.org/xcp-hl/8.3/x86_64/
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=https://rpm.xcp-hl.org/xcp-ng-ce-public.asc
skip_if_unavailable=True

[xcp-hl-xolite]
name=XCP-HL - XO Lite (HomeLab Edition)
baseurl=https://rpm.xcp-hl.org/xolite-ce/8.3/x86_64/
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=https://rpm.xcp-hl.org/xcp-ng-ce-public.asc
skip_if_unavailable=True

[xcp-hl-xoa-proxy]
name=XCP-HL - XOA deploy proxy
baseurl=https://rpm.xcp-hl.org/xoa-proxy/8.3/x86_64/
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=https://rpm.xcp-hl.org/xcp-ng-ce-public.asc
skip_if_unavailable=True
